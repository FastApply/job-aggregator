# Coolify -> worker (branch render-deploy, start: node scripts/render-worker.js) -> Environment Variables.
NODE_ENV=production
DATABASE_URL=
API_SECRET=
MEILI_HOST=http://meilisearch-<uuid>:7700
MEILI_MASTER_KEY=
MEILI_INDEX=jobs                    # must match the web app (its default is also "jobs")
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WONSULTING_COOKIE=
DEMAND_STARVED_SHARE=0.4
SEARCH_CANARY_URL=https://board.fastapply.co/api/jobs   # default still points at the retired Render URL
# One claim queue across every platform, stalest company first.
CRAWL_ATS=workday,icims,oracle,successfactors,greenhouse,bamboohr,smartrecruiters,rippling,ashby,lever,recruitee,breezy,jazzhr,teamtailor,jobvite,comeet,pinpoint,paylocity,zoho,personio
CONCURRENCY=12
BATCH=48
DELAY_MS=300
FETCH_TIMEOUT=300000                # big Workday tenants need minutes; the 60s default timed them out
CRAWL_HEAP_MB=4096                  # crawler child heap cap (render-worker.js); 224 was the 512MB Render size
PG_POOL_MAX=4                       # used by the parent AND the crawler child, so the worker holds up to 8
