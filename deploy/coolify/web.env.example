# Coolify -> web app (branch render-web) -> Environment Variables. Keys only; values live in Coolify.
NODE_ENV=production                 # required: enables the TLS Heroku Postgres demands
PORT=10000                          # must match Coolify "Ports Exposes"
DATABASE_URL=                       # Heroku fastapply-board
API_SECRET=                         # same secret the clients sign tokens with
MEILI_HOST=http://meilisearch-<uuid>:7700
MEILI_MASTER_KEY=                   # the key set on the Coolify Meilisearch resource
PG_POOL_MAX=15
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
