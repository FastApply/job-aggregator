>\\n<li>Lead and d\"});</script>\n<script>var viewModel = { title: function() { var params = {\"opportunityTitle\":\"Claim Director\",\"jobBoardName\":\"Opportunities\"}; } };</script>",
 "str1026strme": "<div slot=\"header\" id=\"new-nav-header\"></div>\n<script>var d = new US.Opportunity.CandidateOpportunityDetail({\"Id\": \"f159c336-e7d8-4dcd-9a46-5140f3bf167f\", \"Title\": \"Senior Metrology Engineer\", \"JobLocationType\": 1, \"Description\": \"<p><em><strong>IMPORTANT: This Position Requires On-Site Work in Mooresville, North Carolina</strong></em></p>\\n<p>Relocation Assistance Available for Qualified Out-of-State Candidates</p>\\n<p>Structure Medical is seeking CNC Machinists who are willing to work on-site at our Mooresville, North Carolina manufacturing facility. This is not a remote or hybrid position. We welcome qualified candidates from across the country and offer relocation assistance for eligible applicants.</p>\\n<p>&nbsp;</p>\\n<p>The Senior Metrology Engineer serves as the subject matter expert for dimensional inspection methodologies, measurement uncertainty, GD&amp;T interpretation, and metrology best practices while supporting manufacturing, quality, engineering, and customer requirements.</p>\\n<p>The Senior Metrology Engineer is responsible for developing, implementing, validating, and improving measurement systems used to ensure product conformity and compliance with customer, regulatory, and company requirements. This position provides technical leadership for inspection methods, Coordinate Measuring Machine (CMM) programming, measurement system analysis, gauge development, and dimensional problem solving in a regulated ISO 13485 medical device manufacturing environment.</p>\\n<p><strong>Essential Functions</strong></p>\\n<ul>\\n<li>Lead development and optimization of dimensional inspection strategies for medical device components and assemblies.</li>\\n<li>Program, validate, troubleshoot, and maintain CMM inspe\"});</script>\n<script>var viewModel = { title: function() { var params = {\"opportunityTitle\":\"Senior Metrology Engineer\",\"jobBoardName\":\"Careers\"}; } };</script>",
