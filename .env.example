# Copy to .env and fill in. Only the REQUIRED block is needed to start the API.
# .env is gitignored — never commit real values.

# ---------------------------------------------------------------- REQUIRED

# Postgres. Everything reads this; nothing works without it.
# Heroku: heroku config:get DATABASE_URL -a fastapply-board
DATABASE_URL=postgres://user:password@host:5432/dbname

# Must be "production" against a hosted Postgres — it enables TLS, which Heroku requires.
NODE_ENV=production

# ---------------------------------------------------------------- API

PORT=3000

# JWT signing secret for /api/jobs. If UNSET, the API is fully open — auth middleware
# short-circuits when this is empty. Set it in any deployed environment.
# Mint client tokens with POST /api/auth/token using this value as the bearer.
API_SECRET=

LOG_LEVEL=info

# ---------------------------------------------------------------- SEARCH

# Meilisearch. Unset = the search path no-ops and /api/jobs serves from Postgres,
# which is much slower on a 5M-row table. On Render this is a PRIVATE service, so it
# is only reachable from inside Render — it cannot be set from a laptop.
#
# The key variable is MEILI_MASTER_KEY — that is the name src/utils/meili.js reads.
# It was documented here as MEILI_KEY until 2026-08-30, which fails silently rather
# than loudly: `enabled` is gated on MEILI_HOST alone, and the Authorization header is
# attached only `if (KEY)`. So a host with a misnamed key sends NO auth, Meili answers
# 401, jobs-search.js catches it and returns null, and every request quietly serves
# from Postgres with servedBy:"postgres" — the 2026-08-20 outage path, on a board that
# looks correctly configured.
MEILI_HOST=
MEILI_MASTER_KEY=
MEILI_INDEX=jobs

# Force the old Postgres search path. Leave unset in normal operation.
# SEARCH_ENGINE=postgres

# Client-side timeout for a Meili query before falling back to Postgres.
MEILI_TIMEOUT_MS=25000

# ---------------------------------------------------------------- INGESTION

# Retire a job after it is missing from this many CONSECUTIVE successful syncs.
# SYNC_ABSENCE_REMOVAL=1 arms it; without that the counter increments but nothing is
# removed. Set by scripts/launch-local-crawlers.sh for the crawler fleet.
SYNC_ABSENCE_REMOVAL=0
SYNC_ABSENT_LIMIT=3

# Postgres pool size PER PROCESS. The Heroku role allows 40 connections total and the
# fleet runs ~11 crawlers, so keep this small — 1 or 2.
PG_POOL_MAX=2
PG_STATEMENT_TIMEOUT=15000

# ---------------------------------------------------------------- OPTIONAL / EXTERNAL

# BrightData Web Unlocker, for boards that block direct requests.
# BRIGHTDATA_PROXY=1 turns it on; without it the unlocker helper returns null and
# callers degrade rather than failing.
# NOTE (2026-08): the primary key returns HTTP 407. The STANDBY key works.
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_API_KEY_STANDBY=
BRIGHT_DATA_ZONE=web_unlocker1
BRIGHTDATA_PROXY=0
# Comma list of hosts to route through the unlocker. Deliberately narrow — this is
# metered, and a wide list burns the plan.
BD_ROUTE_HOSTS=apply.workable.com

# IPRoyal residential proxy, metered by the GB.
# NOTE (2026-08-08): this account is dead and Workable now blocks outright.
IPROYAL_PROXY_HOST=
IPROYAL_PROXY_PORT=
IPROYAL_PROXY_USER=
IPROYAL_PROXY_PASS=
IPROYAL_PROXY_LIFETIME=10m

# OpenAI, used only by the experience-level classification backfill.
OPENAI_API_KEY=

# Serper (Google SERP API), used by SERP-based discovery. Quota exhausted as of 2026-08.
SERPER_API_KEY=

# ---------------------------------------------------------------- LEGACY

# BullMQ/Redis sync queue. RETIRED — sync moved to the local crawler fleet and the
# Render worker. Leave UNSET: setting it spawns an ioredis retry loop against a
# Redis that no longer exists.
REDIS_URL=

# Local SQLite path. Only used by the handful of scripts that stage data locally
# before pushing to Postgres.
DATABASE_PATH=./data/jobs.db
